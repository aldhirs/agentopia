{
  "name": "agentopia",
  "productName": "Agentopia",
  "version": "0.1.0",
  "private": true,
  "description": "Visualisasi sesi Claude Code sebagai kantor virtual",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dist": "electron-vite build && electron-builder --mac dmg --arm64 --publish never",
    "icon": "electron scripts/make-icon.cjs",
    "lint": "eslint .",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "three": "^0.187.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "author": "aldhirs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aldhirs/agentopia.git"
  }
}
